{
  "Package": "vulcan",
  "Type": "Package",
  "Title": "VirtUaL ChIP-Seq data Analysis using Networks",
  "Version": "1.32.0",
  "Author": "Federico M. Giorgi, Andrew N. Holding, Florian Markowetz",
  "Maintainer": "Federico M. Giorgi <federico.giorgi@gmail.com>",
  "Description": "Vulcan (VirtUaL ChIP-Seq Analysis through Networks) is a\npackage that interrogates gene regulatory networks to infer\ncofactors significantly enriched in a differential binding\nsignature coming from ChIP-Seq data. In order to do so, our\npackage combines strategies from different BioConductor\npackages: DESeq for data normalization, ChIPpeakAnno and\nDiffBind for annotation and definition of ChIP-Seq genomic\npeaks, csaw to define optimal peak width and viper for applying\na regulatory network over a differential binding signature.",
  "License": "LGPL-3",
  "biocViews": "SystemsBiology, NetworkEnrichment, GeneExpression, ChIPSeq",
