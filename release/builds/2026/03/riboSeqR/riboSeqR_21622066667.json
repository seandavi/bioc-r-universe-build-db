  "_help": [
    {
      "page": "riboSeqR-package",
      "title": "Analysis of sequencing data from ribosome profiling experiments.",
      "topics": [
        "riboSeqR-package",
        "riboSeqR"
      ]
    },
    {
      "page": "filterHits",
      "title": "Filters framecalled data based on the mean number of hits observed across a replicate group.",
      "topics": [
        "filterHits"
      ]
    },
    {
      "page": "findCDS",
      "title": "Parses a transcriptome file looking for start/stop codons in frame.",
      "topics": [
        "findCDS"
      ]
    },
    {
      "page": "frameCounting",
      "title": "Counts aligned reads within coding sequence regions by frame and footprint size, splitting by frame and footprint size.",
      "topics": [
        "frameCounting"
      ]
    },
    {
      "page": "lengthDist",
      "title": "A function plotting the density of lengths in a riboData object.",
      "topics": [
        "lengthDist"
      ]
    },
    {
      "page": "libScales",
      "title": "Generates library scaling factors from ribosome footprint (and associated RNA) data.",
      "topics": [
        "libScales"
      ]
    },
    {
      "page": "logoContext",
      "title": "Produces a motif of coding start context",
      "topics": [
        "logoContext"
      ]
    },
    {
      "page": "plotCDS",
      "title": "Plots average ribosome footprint alignment to coding sequences at 5' and 3' ends.",
      "topics": [
        "plotCDS"
      ]
    },
    {
      "page": "plotTranscript",
      "title": "Plots ribosome footprint abundance and mRNA coverage (if available) for a specific transcript.",
      "topics": [
        "plotTranscript"
      ]
    },
    {
      "page": "frameShift",
      "title": "Analyses frame called ribosome footprint data within coding sequences and identifies likely frame-shift of different length ribosome footprint reads.",
      "topics": [
        "plotFS",
        "readingFrame"
      ]
    },
    {
      "page": "readRibodata",
      "title": "Reads ribosomal and (optionally) rna data from alignment files.",
      "topics": [
        "readRibodata"
      ]
    },
    {
      "page": "riboCoding-class",
      "title": "Class \"riboCoding\"",
      "topics": [
        "riboCoding",
        "riboCoding-class",
        "show,riboCoding-method",
        "[,riboCoding,ANY,ANY-method",
        "[,riboCoding,ANY-method",
        "[,riboCoding-method"
      ]
    },
    {
      "page": "riboData-class",
      "title": "Class \"riboData\"",
      "topics": [
        "riboData",
        "riboData-class"
      ]
    },
    {
      "page": "rnaCounts",
      "title": "Extracts mRNA counts from a riboDat object for a set of coding sequence coordinates.",
      "topics": [
        "rnaCounts"
      ]
    },
    {
      "page": "sliceCounts",
      "title": "Slices out count data from riboCoding object for use in differential translation analyses.",
      "topics": [
        "sliceCounts"
      ]
