      "title": "The function uses the DEGs to retrieves the different pathways in which those DEGs involve any interaction.",
      "topics": [
        "DEGsToPathways"
      ]
    },
    {
      "page": "downloadPublicSeries",
      "title": "Download automatically samples from NCBI/GEO and ArrayExpress public databases.",
      "topics": [
        "downloadPublicSeries"
      ]
    },
    {
      "page": "featureSelection",
      "title": "featureSelection function calculates the optimal order of DEGs to achieve the best result in the posterior machine learning process by using mRMR algorithm or Random Forest. Furthermore, the ranking is returned and can be used as input of the parameter vars_selected in the machine learning functions.",
      "topics": [
        "featureSelection"
      ]
    },
    {
      "page": "fileMove",
      "title": "This function is used to move files to other locations.",
      "topics": [
        "fileMove"
      ]
    },
    {
      "page": "gdcClientDownload",
      "title": "This function downloads a list of controlled files from GDC Portal with the user token and the manifest with the information about the desired controlled files.",
      "topics": [
        "gdcClientDownload"
      ]
    },
    {
      "page": "geneOntologyEnrichment",
      "title": "geneOntologyEnrichment obtains the information about what Gene Ontology terms are related to the DEGs.",
      "topics": [
        "geneOntologyEnrichment"
      ]
    },
    {
      "page": "getGenesAnnotation",
      "title": "getGenesAnnotation returns the required information about a list of genes from Ensembl biomart.",
      "topics": [
        "getGenesAnnotation"
      ]
    },
    {
      "page": "hisatAlignment",
      "title": "hisatAlignment allows downloading and processing the fastq samples in a CSV file by using hisat2 aligner.",
      "topics": [
        "hisatAlignment"
      ]
    },
    {
      "page": "knn_test",
      "title": "knn_test allows assessing the final DEGs through a machine learning step by using k-NN with a test dataset.",
      "topics": [
        "knn_test"
      ]
    },
    {
      "page": "knn_trn",
      "title": "knn_trn allows assessing the final DEGs through a machine learning step by using k-NN in a cross validation process.",
      "topics": [
        "knn_trn"
      ]
    },
    {
