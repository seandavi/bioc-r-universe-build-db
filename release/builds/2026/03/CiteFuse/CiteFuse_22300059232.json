  "Package": "CiteFuse",
  "Type": "Package",
  "Title": "CiteFuse: multi-modal analysis of CITE-seq data",
  "Version": "1.22.0",
  "Authors@R": "c(\nperson(\"Yingxin\", \"Lin\", email = \"yingxin.lin@sydney.edu.au\", role = c(\"aut\", \"cre\")\n),\nperson(\"Hani\", \"Kim\", email = \"jieun.kim@sydney.edu.au\", role = c(\"aut\"))\n)",
