{
  "Package": "SimFFPE",
  "Type": "Package",
  "Title": "NGS Read Simulator for FFPE Tissue",
  "Version": "1.22.0",
  "Authors@R": "person(\"Lanying\", \"Wei\", email=\"lanying.wei@uni-muenster.de\",\nrole = c(\"aut\", \"cre\"), comment = c(ORCID = \"0000-0002-4281-8017\"))",
  "Description": "The NGS (Next-Generation Sequencing) reads from FFPE\n(Formalin-Fixed Paraffin-Embedded) samples contain numerous\nartifact chimeric reads (ACRS), which can lead to false\npositive structural variant calls. These ACRs are derived from\nthe combination of two single-stranded DNA (ss-DNA) fragments\nwith short reverse complementary regions (SRCRs). This package\nsimulates these artifact chimeric reads as well as normal reads\nfor FFPE samples on the whole genome / several chromosomes /\nlarge regions.",
  "License": "LGPL-3",
  "Encoding": "UTF-8",
  "biocViews": "Sequencing, Alignment, MultipleComparison, SequenceMatching,\nDataImport",
  "Config/pak/sysreqs": "libbz2-dev liblzma-dev xz-utils zlib1g-dev",
