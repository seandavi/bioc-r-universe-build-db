  "Date": "2025-09-07",
  "Authors@R": "person(given = \"Mervin\",\nfamily = \"Fansler\",\nrole = c(\"aut\", \"cre\"),\nemail = \"mervin.fansler@bric.ku.dk\",\ncomment = c(ORCID = \"0000-0002-4108-4218\"))",
