  "Authors@R": "c(person(given=\"DongHyuk\", family=\"Lee\", role=\"aut\", email=\"dhyuklee@pusan.ac.kr\"),\nperson(given=\"Bin\", family=\"Zhu\", role=\"aut\", email=\"bin.zhu@nih.gov\"),\nperson(given=\"Bill\", family=\"Wheeler\", role=\"cre\", email=\"wheelerb@imsweb.com\"))",
