{
  "Package": "clevRvis",
  "Type": "Package",
  "Title": "Visualization Techniques for Clonal Evolution",
  "Version": "1.10.0",
  "Authors@R": "person(\"Sarah\", \"Sandmann\", , \"sarah.sandmann@uni-muenster.de\", role = c(\"aut\", \"cre\"),comment=c(ORCID=\"0000-0002-5011-0641\"))",
  "Description": "clevRvis provides a set of visualization techniques for\nclonal evolution. These include shark plots, dolphin plots and\nplaice plots. Algorithms for time point interpolation as well\nas therapy effect estimation are provided. Phylogeny-aware\ncolor coding is implemented. A shiny-app for generating plots\ninteractively is additionally provided.",
  "License": "LGPL-3",
  "Encoding": "UTF-8",
  "Requires": "shiny, ggraph, igraph, ggiraph, cowplot, htmlwidgets, readxl,\ndplyr, readr, purrr, tibble, patchwork, R.utils, shinyWidgets,\ncolorspace, shinyhelper, shinycssloaders, ggnewscale,\nshinydashboard, DT, colourpicker, grDevices, methods, utils,\nstats, ggplot2, magrittr, tools",
