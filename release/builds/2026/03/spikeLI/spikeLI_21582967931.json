{
  "Package": "spikeLI",
  "Type": "Package",
  "Title": "Affymetrix Spike-in Langmuir Isotherm Data Analysis Tool",
  "Version": "2.70.0",
  "Date": "2009-04-03",
  "Author": "Delphine Baillon, Paul Leclercq <paulleclercq@hotmail.com>,\nSarah Ternisien, Thomas Heim, Enrico Carlon\n<enrico.carlon@fys.kuleuven.be>",
  "Maintainer": "Enrico Carlon <enrico.carlon@fys.kuleuven.be>",
  "Description": "SpikeLI is a package that performs the analysis of the\nAffymetrix spike-in data using the Langmuir Isotherm. The aim\nof this package is to show the advantages of a\nphysical-chemistry based analysis of the Affymetrix microarray\ndata compared to the traditional methods. The spike-in (or\nLatin square) data for the HGU95 and HGU133 chipsets have been\ndownloaded from the Affymetrix web site. The model used in the\nspikeLI package is described in details in E. Carlon and T.\nHeim, Physica A 362, 433 (2006).",
  "License": "GPL-2",
