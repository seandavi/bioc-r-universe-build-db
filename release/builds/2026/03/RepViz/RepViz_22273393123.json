{
  "Package": "RepViz",
  "Type": "Package",
  "Title": "Replicate oriented Visualization of a genomic region",
  "Version": "1.26.0",
  "Author": "Thomas Faux, Kalle Rytk\u00f6nen, Asta Laiho, Laura L. Elo",
  "Maintainer": "Thomas Faux, Asta Laiho <faux.thomas1@gmail.com>\n<asta.laiho@utu.fi>",
  "Description": "RepViz enables the view of a genomic region in a simple\nand efficient way. RepViz allows simultaneous viewing of both\nintra- and intergroup variation in sequencing counts of the\nstudied conditions, as well as their comparison to the output\nfeatures (e.g. identified peaks) from user selected data\nanalysis methods.The RepViz tool is primarily designed for\nchromatin data such as ChIP-seq and ATAC-seq, but can also be\nused with other sequencing data such as RNA-seq, or\ncombinations of different types of genomic data.",
  "License": "GPL-3",
  "Encoding": "UTF-8",
