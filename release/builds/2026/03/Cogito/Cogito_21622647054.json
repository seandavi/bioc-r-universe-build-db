{
  "Package": "Cogito",
  "Type": "Package",
  "Title": "Compare genomic intervals tool - Automated, complete,\nreproducible and clear report about genomic and epigenomic data\nsets",
  "Version": "1.16.0",
  "Date": "2025-07-28",
  "Authors@R": "person(\"Annika\", \"B\u00fcrger\", email=\"a.buerger@uni-muenster.de\",\nrole=c(\"cre\", \"aut\"))",
  "Description": "Biological studies often consist of multiple conditions\nwhich are examined with different laboratory set ups like\nRNA-sequencing or ChIP-sequencing. To get an overview about the\nwhole resulting data set, Cogito provides an automated,\ncomplete, reproducible and clear report about all samples and\nbasic comparisons between all different samples. This report\ncan be used as documentation about the data set or as starting\npoint for further custom analysis.",
  "License": "LGPL-3",
  "Encoding": "UTF-8",
