{
  "Package": "msmsTests",
  "Type": "Package",
  "Title": "LC-MS/MS Differential Expression Tests",
  "Version": "1.48.0",
  "Date": "2013-10-02",
  "Author": "Josep Gregori, Alex Sanchez, and Josep Villanueva",
  "Maintainer": "Josep Gregori i Font <josep.gregori@gmail.com>",
  "Description": "Statistical tests for label-free LC-MS/MS data by spectral\ncounts, to discover differentially expressed proteins between\ntwo biological conditions. Three tests are available: Poisson\nGLM regression, quasi-likelihood GLM regression, and the\nnegative binomial of the edgeR package.The three models admit\nblocking factors to control for nuissance variables.To assure a\ngood level of reproducibility a post-test filter is available,\nwhere we may set the minimum effect size considered biologicaly\nrelevant, and the minimum expression of the most abundant\ncondition.",
  "License": "GPL-2",
  "biocViews": "ImmunoOncology, Software, MassSpectrometry, Proteomics",
  "Config/pak/sysreqs": "libglpk-dev make libicu-dev libxml2-dev\nlibnetcdf-dev libssl-dev zlib1g-dev",
