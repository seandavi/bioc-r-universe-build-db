{
  "Type": "Package",
  "Package": "tidySingleCellExperiment",
  "Title": "Brings SingleCellExperiment to the Tidyverse",
  "Version": "1.20.1",
  "Authors@R": "c(person(\"Stefano\", \"Mangiola\", \ncomment=c(ORCID=\"0000-0001-7474-836X\"),\nemail=\"mangiolastefano@gmail.com\",\nrole=c(\"aut\", \"cre\")))",
  "Description": "'tidySingleCellExperiment' is an adapter that abstracts\nthe 'SingleCellExperiment' container in the form of a 'tibble'.\nThis allows *tidy* data manipulation, nesting, and plotting.\nFor example, a 'tidySingleCellExperiment' is directly\ncompatible with functions from 'tidyverse' packages `dplyr` and\n`tidyr`, as well as plotting with `ggplot2` and `plotly`. In\naddition, the package provides various utility functions\nspecific to single-cell omics data analysis (e.g., aggregation\nof cell-level data to pseudobulks).",
  "License": "GPL-3",
  "VignetteBuilder": "knitr",
  "RdMacros": "lifecycle",
  "Biarch": "true",
