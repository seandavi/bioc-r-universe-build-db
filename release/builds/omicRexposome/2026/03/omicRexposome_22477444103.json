  "Title": "Exposome and omic data associatin and integration analysis",
  "Version": "1.32.0",
  "Authors@R": "c(person(\"Carles\", \"Hernandez-Ferrer\", , \"carles.hernandez@isglobal.org\", c(\"aut\", \"cre\")),\nperson(\"Juan R.\", \"Gonz\u00e1lez\", ,\"juanr.gonzalez@isglobal.org\", role = \"aut\"))",
