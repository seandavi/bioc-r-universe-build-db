  "Package": "LinkHD",
  "Type": "Package",
  "Title": "LinkHD: a versatile framework to explore and integrate\nheterogeneous data",
  "Version": "1.24.0",
  "Author": "Laura M. Zingaretti [aut, cre]",
  "Maintainer": "\"Laura M Zingaretti\" <m.lau.zingaretti@gmail.com>",
