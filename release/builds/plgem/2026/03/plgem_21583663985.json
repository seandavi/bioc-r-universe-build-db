{
  "Package": "plgem",
  "Title": "Detect differential expression in microarray and proteomics\ndatasets with the Power Law Global Error Model (PLGEM)",
  "Version": "1.82.0",
  "Author": "Mattia Pelizzola <mattia.pelizzola@gmail.com> and Norman\nPavelka <normanpavelka@gmail.com>",
  "Description": "The Power Law Global Error Model (PLGEM) has been shown to\nfaithfully model the variance-versus-mean dependence that\nexists in a variety of genome-wide datasets, including\nmicroarray and proteomics data. The use of PLGEM has been shown\nto improve the detection of differentially expressed genes or\nproteins in these datasets.",
  "Maintainer": "Norman Pavelka <normanpavelka@gmail.com>",
