{
  "Package": "biomvRCNS",
  "Type": "Package",
  "Title": "Copy Number study and Segmentation for multivariate biological\ndata",
  "Version": "1.50.0",
  "Date": "2021-11-20",
  "Author": "Yang Du",
  "Maintainer": "Yang Du <tooyoung@gmail.com>",
  "Description": "In this package, a Hidden Semi Markov Model (HSMM) and one\nhomogeneous segmentation model are designed and implemented for\nsegmentation genomic data, with the aim of assisting in\ntranscripts detection using high throughput technology like\nRNA-seq or tiling array, and copy number analysis using aCGH or\nsequencing.",
  "License": "GPL (>= 2)",
