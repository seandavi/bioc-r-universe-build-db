  "Version": "1.20.0",
  "Authors@R": "c(person(c(\"William\", \"M.\"), \"McFadden\", \nemail = \"wmm27@pitt.edu\",\nrole = c(\"cre\", \"aut\")),\nperson(c(\"Judith\", \"L.\"), \"Yanowitz\",\nemail = \"yanowitzjl@mwri.magee.edu\",\nrole = c(\"aut\", \"fnd\")),\nperson(\"Michael\", \"Buszczak\",\nemail = \"michael.buszczak@utsouthwestern.edu\",\nrole = c(\"ctb\", \"fnd\")))",
