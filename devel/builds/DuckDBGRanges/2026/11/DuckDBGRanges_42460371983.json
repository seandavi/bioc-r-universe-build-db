  "_commit": {
    "id": "0822802344290fb728c0375673376d0da91eea46",
    "author": "Patrick Aboyoun <aboyoun.patrick@gene.com>",
    "committer": "Patrick Aboyoun <aboyoun.patrick@gene.com>",
    "message": "Fix DuckDBGRanges Bioconductor nebbiolo2 check NOTEs\n\nVendor local .normarg_seqinfo1()/.normarg_seqinfo2() helpers instead\nof calling unexported GenomicRanges:::normarg_seqinfo1()/\nnormarg_seqinfo2() from the DuckDBGRanges() and DuckDBGRangesList()\nconstructors.\n\nReplace unanchored \\linkS4class{}/\\link{} Rd cross-references to\nGenomicRanges, Seqinfo, S4Vectors, and DuckDBDataFrame classes with\nexplicit \\link[pkg]{Target-class} package anchors.\n",
    "time": 1794090359
  },
