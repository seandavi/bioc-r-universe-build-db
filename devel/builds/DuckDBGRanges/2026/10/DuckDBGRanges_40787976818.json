  "_commit": {
    "id": "4bf0a2c0b7c059a192739c9a958b4bcf45036e6a",
    "author": "Patrick Aboyoun <aboyoun.patrick@gene.com>",
    "committer": "Patrick Aboyoun <aboyoun.patrick@gene.com>",
    "message": "Fix deprecated lambda arrow syntax for DuckDB 2.0\n\nDuckDB 2.0 disables the arrow-style SQL lambda syntax (x -> expr) by\ndefault ahead of its removal in 2.1, breaking DuckDBGRangesList's\nstart/end/width/strand imputation and its .row_idx-based end column\nconstruction with a \"Binder Error: Deprecated lambda arrow (->)\ndetected\" at query materialization. Convert all four list_transform()\ncall sites to the new lambda x: expr syntax.\n",
    "time": 1793207848
  },
