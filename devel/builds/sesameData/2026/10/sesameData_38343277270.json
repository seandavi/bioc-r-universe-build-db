  "Authors@R": "c(person(\"Wanding\", \"Zhou\", role = c(\"aut\",\"cre\",\"fnd\"),\nemail = \"zhouwanding@gmail.com\", comment = c(ORCID = \"0000-0001-9126-1932\")),\nperson(\"Hui\", \"Shen\", role = c(\"aut\",\"fnd\"),\nemail = \"Hui.Shen@vai.org\"),\nperson(\"Timothy\", \"Triche\", role = \"ctb\"))",
