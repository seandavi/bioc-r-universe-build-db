{
  "_id": "6b00c90ba41fd91eece4da94",
  "Package": "dnaEPICO",
  "Title": "dnaEPICO: Analysis Pipeline for Illumina DNA Methylation Array\nData",
  "Version": "0.99.40",
  "Date": "2026-08-18",
  "Authors@R": "person(\"Paul\", \"Ruiz Pinto\", role = c(\"aut\", \"cre\"),\nemail = \"ruizpint@qut.edu.au\",\ncomment = c(ORCID = \"0009-0007-6714-3566\"))",
  "Description": "A modular and reproducible workflow for preprocessing and\nanalysing Illumina DNA methylation array data from the EPICv2,\nEPIC, and 450K platforms. It supports quality control, probe\nfiltering, cell-type deconvolution, phenotype preparation,\nCpG-wise generalised linear models with optional term-level\nomnibus F tests, longitudinal mixed-effects models using\n'lmerTest'/'lme4' or 'nlme', optional 'nlme' residual\ncorrelation structures, and automated reports. The workflow\nuses established Bioconductor tools, including 'minfi',\n'ENmix', and 'wateRmelon', and runs locally or in\nhigh-performance computing environments.",
  "License": "AGPL-3 + file LICENSE",
  "URL": "https://github.com/paulYRP/dnaEPICO",
  "BugReports": "https://github.com/paulYRP/dnaEPICO/issues",
  "VignetteBuilder": "knitr",
  "SystemRequirements": "Quarto command-line interface, GNU make (>= 4.3)",
