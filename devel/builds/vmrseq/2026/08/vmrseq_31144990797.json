  "Title": "Probabilistic Modeling of Single-cell Methylation Heterogeneity",
  "Version": "1.5.1",
  "Authors@R": "c(person(\"Keegan\", \"Korthauer\", , \"kkorthauer@cmmt.ubc.ca\", role = c(\"aut\", \"cre\"),\ncomment = c(ORCID = \"0000-0002-4565-1654\")),\nperson(\"Ning\", \"Shen\", , \"ning.shen.wk@gmail.com\", role = c(\"aut\"),\ncomment = c(ORCID = \"0000-0002-2974-1086\")))",
