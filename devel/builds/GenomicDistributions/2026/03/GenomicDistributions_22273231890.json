      "topics": [
        "binChroms"
      ]
    },
    {
      "page": "binRegion",
      "title": "Divide regions into roughly equal bins",
      "topics": [
        "binRegion"
      ]
    },
    {
      "page": "BSdtToGRanges",
      "title": "Converts a list of data.tables (From BSreadbeds) into GRanges.",
      "topics": [
        "BSdtToGRanges"
      ]
    },
    {
      "page": "calcChromBins",
      "title": "Calculates the distribution of a query set over the genome",
      "topics": [
        "calcChromBins"
      ]
    },
    {
      "page": "calcChromBinsRef",
      "title": "Returns the distribution of query over a reference assembly Given a query set of elements (a GRanges object) and a reference assembly (*e.g. 'hg38'), this will aggregate and count the distribution of the query elements across bins of the reference genome. This is a helper function to create features for common genomes. It is a wrapper of 'calcChromBins', which is more general.",
      "topics": [
        "calcChromBinsRef"
      ]
    },
    {
      "page": "calcChromBinsRefSlow",
      "title": "Returns the distribution of query over a reference assembly Given a query set of elements (a GRanges object) and a reference assembly (*e.g. 'hg38'), this will aggregate and count the distribution of the query elements across bins of the reference genome. This is a helper function to create features for common genomes. It is a wrapper of 'calcChromBins', which is more general.",
      "topics": [
        "calcChromBinsRefSlow"
      ]
    },
    {
      "page": "calcCumulativePartitions",
      "title": "Calculates the cumulative distribution of overlaps between query and arbitrary genomic partitions",
      "topics": [
        "calcCumulativePartitions"
      ]
    },
    {
      "page": "calcCumulativePartitionsRef",
      "title": "Calculates the cumulative distribution of overlaps for a query set to a reference assembly",
      "topics": [
        "calcCumulativePartitionsRef"
      ]
    },
    {
      "page": "calcDinuclFreq",
      "title": "Calculate Dinuclotide content over genomic ranges",
      "topics": [
        "calcDinuclFreq"
      ]
    },
    {
      "page": "calcDinuclFreqRef",
      "title": "Calculate dinucleotide content over genomic ranges",
      "topics": [
        "calcDinuclFreqRef"
      ]
    },
    {
      "page": "calcExpectedPartitions",
      "title": "Calculates expected partiton overlap based on contribution of each feature (partition) to genome size. Expected and observed overlaps are then compared.",
      "topics": [
        "calcExpectedPartitions"
      ]
    },
    {
      "page": "calcExpectedPartitionsRef",
      "title": "Calculates the distribution of observed versus expected overlaps for a query set to a reference assembly",
      "topics": [
        "calcExpectedPartitionsRef"
      ]
    },
    {
      "page": "calcFeatureDist",
      "title": "Find the distance to the nearest genomic feature",
      "topics": [
        "calcFeatureDist"
      ]
    },
    {
      "page": "calcFeatureDistRefTSS",
      "title": "Calculates the distribution of distances from a query set to closest TSS",
