      "topics": [
        "calcGCContentRef"
      ]
    },
    {
      "page": "calcNearestNeighbors",
      "title": "Group regions from the same chromosome together and compute the distance of a region to its nearest neighbor.  Distances are then lumped into a numeric vector.",
      "topics": [
        "calcNearestNeighbors"
      ]
    },
    {
      "page": "calcNeighborDist",
      "title": "Group regions from the same chromosome together and calculate the distances of a region to its upstream and downstream neighboring regions.  Distances are then lumped into a numeric vector.",
      "topics": [
        "calcNeighborDist"
      ]
    },
    {
      "page": "calcPartitions",
