  "_help": [
    {
      "page": "GenomicDistributions-package",
      "title": "Produces summaries and plots of features distributed across genomes",
      "topics": [
        "GenomicDistributions-package",
        "GenomicDistributions"
      ]
    },
    {
      "page": "dot-requireAndReturn",
      "title": "Checks to make sure a package object is installed, and if so, returns it. If the library is not installed, it issues a warning and returns NULL.",
      "topics": [
        ".requireAndReturn"
      ]
    },
    {
      "page": "dot-validateInputs",
      "title": "Checks class of the list of variables. To be used in functions",
      "topics": [
        ".validateInputs"
      ]
    },
    {
      "page": "binBSGenome",
      "title": "Bins a BSgenome object.",
      "topics": [
        "binBSGenome"
      ]
    },
    {
      "page": "binChroms",
