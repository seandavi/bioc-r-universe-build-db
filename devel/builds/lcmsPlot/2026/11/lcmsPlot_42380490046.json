  "_commit": {
    "id": "f9afeeb00e09f375d801ece56a9d30e74cc8783c",
    "author": "Ossama Edbali <ossedb@gmail.com>",
    "committer": "Ossama Edbali <ossedb@gmail.com>",
    "message": "fix(cd-node): install lcmsPlot from the tag's source archive\n\nremotes::install_github() goes through the GitHub API, and without a token of the user's own it falls back to a shared one that GitHub may reject, as it did on the Windows runner. The installer now downloads the source archive of the tag (or commit) from github.com, which needs no token, and installs it with remotes::install_url(). R's empty stderr lines are also no longer logged as 'System.Management.Automation.RemoteException'.\n",
    "time": 1794053879
  },
