  "_help": [
    {
      "page": "basetheme",
      "title": "Package-wide, non-user function used to set a base 'ggplot2' theme.",
      "topics": [
        "basetheme"
      ]
    },
    {
      "page": "clusKNN",
      "title": "A wrapper function for 'Seurat''s 'FindNeighbors' and 'FindClusters'.",
      "topics": [
        "clusKNN"
      ]
    },
    {
      "page": "contourPlot",
      "title": "Draw a contour plot, typically relating to co-ordinates of a 2-dimensional reduction / embedding, typically contained within a 'SingleCellExperiment' object.",
      "topics": [
        "contourPlot"
      ]
    },
    {
      "page": "downsampleByVar",
      "title": "Downsample an input data-frame or matrix based on variance.",
      "topics": [
        "downsampleByVar"
      ]
    },
    {
      "page": "importData",
      "title": "Import a data-frame or matrix, and associated metadata, to a 'SingleCellExperiment' object.",
      "topics": [
        "importData"
      ]
    },
    {
      "page": "markerEnrichment",
      "title": "Find enriched markers per identified cluster and calculate cluster abundances across these for samples and metadata variables.",
      "topics": [
        "markerEnrichment"
      ]
    },
    {
      "page": "markerExpression",
      "title": "Highlight the individual marker expression profile across a 2-dimensional reduction / embedding, typically contained within a 'SingleCellExperiment' object. By default, this function plots the expression profile of 6 randomly-selected markers from your data.",
      "topics": [
        "markerExpression"
      ]
    },
    {
      "page": "markerExpressionPerCluster",
      "title": "Generate box-and-whisker plots illustrating marker expression per k-NN identified cluster. By default, 5 randomly-selected clusters are selected, and the expression profiles of 10 randomly-selected markers are plot across these.",
      "topics": [
        "markerExpressionPerCluster"
      ]
    },
    {
      "page": "metadataPlot",
      "title": "Colour shade a 2-dimensional reduction / embedding based on metadata, typically contained within a 'SingleCellExperiment' object.",
      "topics": [
        "metadataPlot"
      ]
    },
    {
      "page": "performUMAP",
      "title": "Perform UMAP on an input data-frame or matrix, or 'SingleCellExperiment' object, using the basic R implementation of UMAP.",
      "topics": [
        "performUMAP"
      ]
    },
    {
      "page": "plotClusters",
      "title": "Highlight cell-to-cluster assignments across a 2-dimensional reduction / embedding.",
      "topics": [
        "plotClusters"
      ]
    },
    {
      "page": "plotSignatures",
      "title": "Find enriched markers per identified cluster and visualise these as a custom corrplot.",
      "topics": [
        "plotSignatures"
      ]
    },
    {
      "page": "processFCS",
      "title": "Input, filter, normalise, and transform FCS expression data.",
      "topics": [
        "processFCS"
      ]
    }
  ],
