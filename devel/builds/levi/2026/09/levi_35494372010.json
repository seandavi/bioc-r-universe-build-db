  "_commit": {
    "id": "ac8c924642aac186de9e2ca9ccc0b8652fd5ab5c",
    "author": "jrybarczyk <jose.luiz@unesp.br>",
    "committer": "jrybarczyk <jose.luiz@unesp.br>",
    "message": "Build the TFCE graph once per call instead of at every threshold\n\n.componentsAt() rebuilt the igraph object for each of the 100 integration\nsteps, on both sides, in every permutation draw. The graph is now built\nonce in .tfce() and the components are recomputed only when the active\nset changes between consecutive thresholds. Results are identical; the\nleviSingleCellTFCEInference() example drops from 5.2 s to 0.4 s, under the\n5 s limit of the Bioconductor build report.\n\nCo-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>\n",
    "time": 1789858101
  },
