  "License": "GPL (>= 2)",
  "Copyright": "See file inst/COPYRIGHT",
  "SystemRequirements": "GNU make",
  "VignetteBuilder": "knitr",
  "LazyLoad": "yes",
  "Collate": "AllClasses.R AllGenerics.R params-methods.R version-methods.R\nhelperFunctions.R inputChecks.R convertRows.R msaPrettyPrint.R\nprint-methods.R show-methods.R msa.R msaMuscle.R msaClustalW.R\nmsaClustalOmega.R msaConvert.R msaCheckNames.R\nmsaConsensusSequence-methods.R msaConservationScore-methods.R",
  "biocViews": "MultipleSequenceAlignment, Alignment, MultipleComparison,\nSequencing",
