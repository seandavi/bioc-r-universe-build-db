  "Package": "VCFArray",
  "Title": "Representing on-disk / remote VCF files as array-like objects",
  "Version": "1.27.0",
  "Authors@R": "c(\nperson(\"Qian\", \"Liu\", email = \"qliu7@buffalo.edu\", role = c(\"aut\", \"cre\")),\nperson(\"Martin\", \"Morgan\", role = \"aut\"))",
