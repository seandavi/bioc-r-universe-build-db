  "Title": "Client for the Reactome Analysis Service for comparative\nmulti-omics gene set analysis",
  "Version": "1.25.1",
  "Authors@R": "person(\"Johannes\", \"Griss\", , \"johannes.griss@meduniwien.ac.at\", role = c(\"aut\", \"cre\"),\ncomment = c(ORCID = \"0000-0003-2206-9511\"))",
