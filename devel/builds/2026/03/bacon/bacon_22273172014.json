  "Title": "Controlling bias and inflation in association studies using the\nempirical null distribution",
  "Version": "1.39.0",
  "Authors@R": "c(person(\"Maarten\", \"van Iterson\",\nemail=\"mviterson@gmail.com\", role=\"cre\"), person(\"Erik\", \"van\nZwet\", role=\"ctb\"))",
