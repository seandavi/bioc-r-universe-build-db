  "Title": "Identification of putative mammalian orthologs to given enhancer",
  "Version": "1.17.0",
  "Authors@R": "c(person(given=\"Jianhong\", family=\"Ou\", email=\"jou@morgridge.org\", \nrole=c(\"aut\", \"cre\"), comment=c(ORCID=\"0000-0002-8652-2488\")),\nperson(given=\"Valentina\", family=\"Cigliola\", role=c(\"dtc\")),\nperson(given=\"Kenneth\", family=\"Poss\", role=c(\"fnd\")))",
