  "Package": "metaCCA",
  "Type": "Package",
  "Title": "Summary Statistics-Based Multivariate Meta-Analysis of\nGenome-Wide Association Studies Using Canonical Correlation\nAnalysis",
  "Version": "1.39.0",
  "Date": "2016-01-26",
  "Author": "Anna Cichonska <anna.cichonska@gmail.com>",
