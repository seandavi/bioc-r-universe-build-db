{
  "_id": "6af59f9ef58eaab79920b46f",
  "Package": "dar",
  "Title": "Differential Abundance Workflows for Microbiome Data",
  "Version": "1.99.0",
  "Date": "2026-08-04",
  "Authors@R": "c(person(given = \"Francesc\",\nfamily = \"Catala-Moll\",\nrole = c(\"aut\", \"cre\"),\nemail = \"fcatala@irsicaixa.es\",\ncomment = c(ORCID = \"0000-0002-2354-8648\"))\n)",
  "Description": "Provides a recipe-based interface for differential\nabundance analysis of microbiome data. A shared model\nspecification defines covariates, contrasts, reference levels\nand taxonomic aggregation, with compatibility checks for each\nmethod. Pipeable workflows combine preprocessing, quality\ncontrol and multiple differential abundance methods. Results\ncan be inspected in a common format that preserves\nmethod-specific effect scales, visualized and compared. Recipes\ncan be exported and imported using a versioned, non-executable\nformat. Optional consensus rules summarize agreement across\nmethods for each contrast and effect direction.",
  "License": "MIT + file LICENSE",
  "Encoding": "UTF-8",
  "Roxygen": "list(roclets = c(\"collate\", \"namespace\", \"rd\",\n\"roxytest::testthat_roclet\", \"roxyglobals::global_roclet\"),\nmarkdown = TRUE)",
  "URL": "https://github.com/MicrobialGenomics-IrsicaixaOrg/dar,\nhttps://microbialgenomics-irsicaixaorg.github.io/dar/",
