  "_commit": {
    "id": "926e1e53a60bb190fbf6ff212750983ff56e1bf6",
    "author": "Robert Castelo <robert.castelo@upf.edu>",
    "committer": "Robert Castelo <robert.castelo@upf.edu>",
    "message": "Replace BiocParallel::bpiterate(), which is not supported by the\nDoparParam back-end, by calls to bplapply() in rounds of one block per\nworker, when socket or foreach workers receive blocks of an in-memory\ninput from the main process. The main process frees the blocks of each\nround before taking the next ones, and the copies it holds are now\nincluded in the memory budget given by 'maxmem' and in the memory\nestimated before the calculations start. Added doParallel and foreach to\nSuggests, for a new unit test on the DoparParam back-end.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n",
    "time": 1792658566
  },
