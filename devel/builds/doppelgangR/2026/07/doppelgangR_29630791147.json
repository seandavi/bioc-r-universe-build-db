  "Authors@R": "c(person(\"Levi\", \"Waldron\", email = \"lwaldron.research@gmail.com\",\nrole = c(\"aut\", \"cre\")),\nperson(\"Markus\", \"Reister\", email = \"markus.riester@novartis.com\",\nrole = c(\"aut\", \"ctb\")),\nperson(\"Marcel\", \"Ramos\", email = \"marcel.ramos@sph.cuny.edu\",\nrole = \"ctb\"))",
