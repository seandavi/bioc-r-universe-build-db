  "Package": "HiLDA",
  "Type": "Package",
  "Title": "Conducting statistical inference on comparing the mutational\nexposures of mutational signatures by using hierarchical latent\nDirichlet allocation",
  "Version": "1.25.0",
  "Date": "2021-10-13",
  "Authors@R": "c(person(\"Zhi\", \"Yang\", email = \"zyang895@gmail.com\", \nrole = c(\"aut\", \"cre\")),\nperson(\"Yuichi\", \"Shiraishi\", email = \"friend1ws@gmail.com\",\nrole = \"ctb\"))",
