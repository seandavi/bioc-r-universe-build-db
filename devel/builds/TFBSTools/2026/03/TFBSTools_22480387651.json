  "VignetteBuilder": "knitr",
  "License": "GPL-2",
  "URL": "https://github.com/ge11232002/TFBSTools",
  "BugReports": "https://github.com/ge11232002/TFBSTools/issues",
  "Type": "Package",
  "biocViews": "MotifAnnotation, GeneRegulation, MotifDiscovery,\nTranscription, Alignment",
