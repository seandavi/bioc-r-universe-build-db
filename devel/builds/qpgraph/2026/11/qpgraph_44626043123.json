{
  "_id": "6aff7ca526e1f52ab707e7c8",
  "Package": "qpgraph",
  "Title": "Estimation of Genetic and Molecular Regulatory Networks from\nHigh-Throughput Genomics Data",
  "Version": "2.47.3",
  "Authors@R": "c(person(\"Robert\", \"Castelo\", role=c(\"aut\", \"cre\"), email=\"robert.castelo@upf.edu\"),\nperson(\"Alberto\", \"Roverato\", role=\"aut\", email=\"alberto.roverato@unibo.it\"))",
  "Description": "Estimate gene and eQTL networks from high-throughput\nexpression and genotyping assays. The implemented methodology\nis based on undirected Gaussian graphical models, and more\nconcretely, in q-order partial correlation graphs, or qp-graphs\nfor short. The qp-graph methodology provides a robust way to\nestimate direct associations from multivariate data where the\nnumber of random variables p (in this case the number of genes\nin the rows) is much larger than the number of multivariate\nobservations n (in this case the number of samples in the\ncolumns, i.e., where p >> n.",
  "License": "GPL (>= 2)",
  "LazyData": "yes",
  "URL": "https://github.com/rcastelo/qpgraph",
  "BugReports": "https://github.com/rcastelo/qpgraph/issues",
