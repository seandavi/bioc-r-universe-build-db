{
  "_id": "6afe240db0151ec0d657ef85",
  "Package": "TiDEomics",
  "Title": "Time-course Differential Expression analysis of omics data",
  "Version": "0.99.9",
  "Date": "2026-11-17",
  "Authors@R": "person(\"Tianen\", \"He\",\nemail = \"tianen.he@ndm.ox.ac.uk\",\nrole = c(\"aut\", \"cre\"),\ncomment = c(ORCID = \"0000-0001-6864-0723\"))",
  "Description": "TiDEomics provides an integrated workflow for multi-group\ntime-course omics data analysis. It uses model-based\ndifferential expression, variance decomposition, and\nco-expression module analysis with WGCNA to characterise\ntemporal, group, and group-specific temporal effects.\nMulti-dataset and multi-omics comparisons and consensus module\nidentification can be performed using shared features. The\npackage includes quality control, data processing, functional\nenrichment, and integrated visualisation. It supports data with\nmissing values, and operates on SummarizedExperiment objects\nfor interoperability with the Bioconductor ecosystem.",
  "License": "GPL (>= 2)",
  "URL": "https://bioconductor.org/packages/TiDEomics/,\nhttps://github.com/hte123/TiDEomics,\nhttps://hte123.github.io/TiDEomics",
  "BugReports": "https://github.com/hte123/TiDEomics/issues",
  "biocViews": "Software, GeneExpression, DifferentialExpression,\nProteomics, Transcriptomics, TimeCourse, MultipleComparison,\nPathways, Visualization, QualityControl",
