  "_commit": {
    "id": "2c35c60064e5b07cc7011299bafd2e3725cfcd3b",
    "author": "Damian <damian.szk@gmail.com>",
    "committer": "Damian <damian.szk@gmail.com>",
    "message": "Stop on STRING server errors instead of parsing the error page\n\npostFormSmart returned the body of any response as data, so a gateway\ntimeout (e.g. HTTP 524) came back as a data frame whose column was the\nCloudflare error message. Requests answered with HTTP 5xx now stop with the\nstatus code. Client errors (4xx, e.g. 404 for unknown identifiers) keep\ntheir previous behaviour.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>\n",
    "time": 1790688193
