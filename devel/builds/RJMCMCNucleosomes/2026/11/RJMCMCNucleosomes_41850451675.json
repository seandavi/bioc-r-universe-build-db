{
  "_id": "6aeb47831e2c7b3a4f5351cc",
  "Package": "RJMCMCNucleosomes",
  "Version": "1.37.1",
  "Date": "2025-07-28",
  "Title": "Bayesian hierarchical model for genome-wide nucleosome\npositioning with high-throughput short-read data (MNase-Seq)",
  "Description": "This package detects nucleosome positions genome-wide from\npaired-end or single-end MNase-Seq reads using a Bayesian\nhierarchical model. Read positions are modelled as a mixture of\nStudent's t-distributions with an informative\nMultinomial-Dirichlet prior on nucleosome locations, and the\nnumber of nucleosomes is estimated with a reversible jump\nMarkov chain Monte Carlo (RJMCMC) algorithm. Functions are\nprovided to split chromosomes into segments for parallel\nanalysis, merge and post-process the predictions, and plot\nnucleosome positions alongside read coverage. This package\nimplements the method described in Samb et al. 2015\n(DOI:10.1515/sagmb-2014-0098).",
  "Authors@R": "c(person(\"Pascal\", \"Belleau\",\nemail=\"pascal_belleau@hotmail.com\", role=c(\"aut\"),\ncomment=c(ORCID=\"0000-0002-0802-1071\")),\nperson(\"Rawane\", \"Samb\",\nemail=\"rawane.samb.1@ulaval.ca\", role=c(\"aut\")),\nperson(\"Astrid\", \"Desch\u00eanes\",\nemail=\"adeschen@hotmail.com\",\nrole=c(\"cre\",\"aut\"), comment=c(ORCID=\"0000-0001-7846-6749\")),\nperson(\"Khader\", \"Khadraoui\",\nemail=\"Khader.Khadraoui@mat.ulaval.ca\", role=c(\"aut\")),\nperson(\"Lajmi\", \"Lakhal-Chaieb\",\nemail=\"Lajmi.Lakhal@mat.ulaval.ca;\", role=c(\"aut\")),\nperson(\"Arnaud\", \"Droit\",\nemail=\"arnaud.droit@crchuq.ulaval.ca\", role=c(\"aut\")))",
