  "_id": "6afe1b4f9eaf20cf7c07a492",
  "Package": "OmaDB",
  "Title": "R wrapper for the OMA REST API",
  "Version": "2.29.2",
  "Authors@R": "c(\nperson(\"Klara\", \"Kaleb\", role = \"aut\"),\nperson(\"Adrian\", \"Altenhoff\",\nemail = \"adrian.altenhoff@inf.ethz.ch\",\nrole = c(\"aut\", \"cre\"),\ncomment = c(ORCID = \"0000-0001-7492-1273\")))",
  "Description": "A package for the orthology prediction data download from\nthe OMA browser database (https://omabrowser.org). It provides\naccess to proteins, genomes, Hierarchical Orthologous Groups\n(HOGs), OMA Groups, pairwise orthologs, the taxonomy and\n(ancestral) synteny via the OMA REST API. The results are\nreturned as data.frames or objects using standard Bioconductor\nclasses such as GRanges and AAString, and can be used for\ndownstream analyses, e.g. Gene Ontology enrichment with topGO.\nResponses are cached in memory and optionally on disk.",
  "URL": "https://github.com/DessimozLab/OmaDB, https://omabrowser.org",
  "BugReports": "https://github.com/DessimozLab/OmaDB/issues",
