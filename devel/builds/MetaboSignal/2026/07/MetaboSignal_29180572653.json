  "_id": "6a53245a9b92047c28d55bc6",
  "Package": "MetaboSignal",
  "Type": "Package",
  "Title": "MetaboSignal: a network-based approach to overlay and explore\nmetabolic and signaling KEGG pathways",
  "Version": "1.43.0",
  "Date": "2023-12-16",
  "Author": "Andrea Rodriguez-Martinez, Rafael Ayala, Joram M. Posma, Ana L.\nNeves, Maryam Anwar, Jeremy K. Nicholson, Marc-Emmanuel Dumas",
  "Maintainer": "Andrea Rodriguez-Martinez\n<andrea.rodriguez-martinez13@imperial.ac.uk>, Rafael Ayala\n<rafaelayalahernandez@gmail.com>",
  "Description": "MetaboSignal is an R package that allows merging,\nanalyzing and customizing metabolic and signaling KEGG\npathways. It is a network-based approach designed to explore\nthe topological relationship between genes (signaling- or\nenzymatic-genes) and metabolites, representing a powerful tool\nto investigate the genetic landscape and regulatory networks of\nmetabolic phenotypes.",
  "License": "GPL-3",
  "VignetteBuilder": "knitr",
