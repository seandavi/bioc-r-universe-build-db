  "_commit": {
    "id": "f184b1a40a4c9fcc23997c320ceab606b65bca7c",
    "author": "LiNk-NY <marcel.ramos@sph.cuny.edu>",
    "committer": "LiNk-NY <marcel.ramos@sph.cuny.edu>",
    "message": "Use the Bioconductor reusable CI workflow\n\nReplace basic_checks.yml and test-coverage.yml with ci.yml, the\nBioconductor/workflows template. It calls the shared bioccheck.yml\nworkflow, which runs R CMD check and BiocCheck in the Bioconductor\ncontainer and uploads coverage to Codecov with the existing\nCODECOV_TOKEN secret.\n\nLeave 'master' out of the CI branch lists, since Bioconductor's default\nbranch has been 'devel' since 2023, and use 'main' instead of 'master'\nin the test package's example GitLab URL. The upstream template still\nlists 'master'; see Bioconductor/workflows#41.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n",
    "time": 1794607291
  },
