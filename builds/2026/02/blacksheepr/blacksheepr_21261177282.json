  "_help": [
    {
      "page": "annotationlist_builder",
      "title": "Create the annotation object for plotting in a heatmap",
      "topics": [
        "annotationlist_builder"
      ]
    },
    {
      "page": "comparison_groupings",
      "title": "Create all of the groups based on the input metadata",
      "topics": [
        "comparison_groupings"
      ]
    },
    {
      "page": "count_outliers",
      "title": "Count up the outlier information for each of the groups you have made. If aggregating then you will have to turn the parameter on, but you still input the outliertable. Aggregate will count the total number of outliers AND nonoutliers in its operation, so it needs the original outlier table made by the <make_outlier_table> function.",
      "topics": [
        "count_outliers"
      ]
    },
    {
      "page": "create_heatmap",
      "title": "Plot out a heatmap",
      "topics": [
        "create_heatmap"
      ]
    },
    {
      "page": "deva",
      "title": "Run the entire blacksheep Function from Start to finish",
      "topics": [
        "deva"
      ]
    },
    {
      "page": "deva_normalization",
      "title": "Normalization of data to prepare for deva. Uses a Median of Ratio method followed by a log2 transformation.",
      "topics": [
        "deva_normalization"
      ]
    },
    {
      "page": "deva_results",
      "title": "Utility function that allows easier grabbing of data",
      "topics": [
        "deva_results"
      ]
    },
    {
      "page": "make_comparison_columns",
      "title": "Utility function that will take in columns with several subcategories, and output several columns each with binary classifications. ex) col1: A,B,C >> colA: A,notA,notA; colB: notB,B,notB; colC: notC,notC,C",
      "topics": [
        "make_comparison_columns"
      ]
    },
    {
      "page": "make_outlier_table",
      "title": "Separate out the \"i\"th gene, take the bounds, and then create a column that says whether or not this gene is high, low, or none in a sample with regards to the other samples in the dataset. Repeat this for every gene to create a reference table.",
      "topics": [
        "make_outlier_table"
      ]
    },
    {
      "page": "outlier_analysis",
      "title": "With the grouptablist generated by count_outliers - run through and run a fisher exact test to get the p.value for the difference in outlier count for each feature in each of your comparisons",
      "topics": [
        "outlier_analysis"
      ]
    },
    {
      "page": "outlier_heatmap",
      "title": "With the grouptablist generated by count_outliers - run through and run a fisher exact test to get the p.value for the difference in outlier count for each feature in each of your comparisons",
      "topics": [
        "outlier_heatmap"
      ]
    },
