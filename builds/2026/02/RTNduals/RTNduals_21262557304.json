  "Package": "RTNduals",
  "Type": "Package",
  "Title": "Analysis of co-regulation and inference of 'dual regulons'",
  "Version": "1.35.0",
  "Author": "Vinicius S. Chagas, Clarice S. Groeneveld, Gordon Robertson,\nKerstin B. Meyer, Mauro A. A. Castro",
