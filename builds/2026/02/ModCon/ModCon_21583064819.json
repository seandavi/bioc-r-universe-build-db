{
  "Package": "ModCon",
  "Type": "Package",
  "Title": "Modifying splice site usage by changing the mRNP code, while\nmaintaining the genetic code",
  "Version": "1.19.0",
  "Authors@R": "person(\"Johannes\", \"Ptok\", role = c(\"aut\", \"cre\"), email = \"Johannes.Ptok@posteo.de\", comment = c(ORCID = \"0000-0002-0322-5649\"))",
  "Description": "Collection of functions to calculate a nucleotide sequence\nsurrounding for splice donors sites to either activate or\nrepress donor usage. The proposed alternative nucleotide\nsequence encodes the same amino acid and could be applied e.g.\nin reporter systems to silence or activate cryptic splice donor\nsites.",
