{
  "Package": "DNABarcodes",
  "Type": "Package",
  "Title": "A tool for creating and analysing DNA barcodes used in Next\nGeneration Sequencing multiplexing experiments",
  "Version": "1.41.0",
  "Date": "2014-07-23",
  "Author": "Tilo Buschmann <tilo.buschmann.ac@gmail.com>",
  "Maintainer": "Tilo Buschmann <tilo.buschmann.ac@gmail.com>",
  "Description": "The package offers a function to create DNA barcode sets\ncapable of correcting insertion, deletion, and substitution\nerrors. Existing barcodes can be analysed regarding their\nminimal, maximal and average distances between barcodes.\nFinally, reads that start with a (possibly mutated) barcode can\nbe demultiplexed, i.e., assigned to their original reference\nbarcode.",
  "License": "GPL-2",
