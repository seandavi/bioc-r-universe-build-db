  "Package": "multiMiR",
  "Title": "Integration of multiple microRNA-target databases with their\ndisease and drug associations",
  "Version": "1.33.0",
  "Authors@R": "c(\nperson(\"Yuanbin\", \"Ru\", email = \"ruyuanbin@gmail.com\", role = c(\"aut\")),\nperson(\"Matt\", \"Mulvahill\", email = \"matt.mulvahill@gmail.com\", role = c(\"aut\")),\nperson(\"Spencer\", \"Mahaffey\", email = \"Spencer.Mahaffey@cuanschutz.edu\", role = c(\"cre\",\"aut\")),\nperson(\"Katerina\", \"Kechris\", email = \"Katerina.Kechris@ucdenver.edu\", role = c(\"aut\", \"cph\", \"ths\")))",
