  "_commit": {
    "id": "7e24dbd7006d89e208e0cf6aa0eb94afacd8028f",
    "author": "Herv\u00e9 Pag\u00e8s <hpages.on.github@gmail.com>",
    "committer": "Herv\u00e9 Pag\u00e8s <hpages.on.github@gmail.com>",
    "message": "igblastr 1.1.15\n\nRename argument 'force' of functions install_igblast(),\ninstall_IMGT_germline_db(), and install_IMGT_c_region_db(),\nto 'overwrite'. This is a better name and is more consistent\nwith base R things like data(), unzip(), file.copy(), etc...\n\nigblastr was released very recently and has very little downloads/usage\nso far, so I hope this breaking change won't affect too many users.\nI apologize in advance to the affected users for the inconvenience.\n",
    "time": 1771826299
  },
