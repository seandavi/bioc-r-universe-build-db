{
  "Package": "ASAFE",
  "Type": "Package",
  "Title": "Ancestry Specific Allele Frequency Estimation",
  "Version": "1.37.0",
  "Date": "2016-04-24",
  "Author": "Qian Zhang <qszhang@uw.edu>",
  "Maintainer": "Qian Zhang <qszhang@uw.edu>",
  "Description": "Given admixed individuals' bi-allelic SNP genotypes and\nancestry pairs (where each ancestry can take one of three\nvalues) for multiple SNPs, perform an EM algorithm to deal with\nthe fact that SNP genotypes are unphased with respect to\nancestry pairs, in order to estimate ancestry-specific allele\nfrequencies for all SNPs.",
  "License": "Artistic-2.0",
  "biocViews": "SNP, GenomeWideAssociation, LinkageDisequilibrium,\nBiomedicalInformatics, Genetics, ExperimentalDesign",
  "LazyData": "TRUE",
  "VignetteBuilder": "knitr",
  "Collate": "estep.R nudge.R mstep.R increment_n.R em.R algorithm_1snp.R\nalgorithm_1snp_wrapper.R get_mean_sd_error_anc_bin.R\nget_mean_sd_error_anc.R change_ancestry.R\ndraw_allele_given_anc.R get_errors_1_scenario.R\nget_errors_summary_stats_1_scenario.R get_results_error.R\nget_scenario_errors.R get_true_freqs_1snp.R sample_ancestry.R",
