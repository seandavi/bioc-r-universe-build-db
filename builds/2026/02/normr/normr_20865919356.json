{
  "Package": "normr",
  "Type": "Package",
  "Title": "Normalization and difference calling in ChIP-seq data",
  "Version": "1.37.0",
  "Date": "2021-09-21",
  "Authors@R": "c(person(given=\"Johannes\",family=\"Helmuth\",\nemail=\"johannes.helmuth@laborberlin.com\", role=c(\"aut\", \"cre\")),\nperson(given=\"Ho-Ryun\",family=\"Chung\",\nemail=\"chung@molgen.mpg.de\", role=c(\"aut\")))",
  "Author": "Johannes Helmuth [aut, cre], Ho-Ryun Chung [aut]",
  "Maintainer": "Johannes Helmuth <johannes.helmuth@laborberlin.com>",
  "Description": "Robust normalization and difference calling procedures for\nChIP-seq and alike data. Read counts are modeled jointly as a\nbinomial mixture model with a user-specified number of\ncomponents. A fitted background estimate accounts for the\neffect of enrichment in certain regions and, therefore,\nrepresents an appropriate null hypothesis. This robust\nbackground is used to identify significantly enriched or\ndepleted regions.",
  "License": "GPL-2",
  "SystemRequirements": "C++11",
  "biocViews": "Bayesian, DifferentialPeakCalling, Classification,\nDataImport, ChIPSeq, RIPSeq, FunctionalGenomics, Genetics,\nMultipleComparison, Normalization, PeakDetection,\nPreprocessing, Alignment",
