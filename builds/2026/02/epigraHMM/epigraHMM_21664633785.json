{
  "Package": "epigraHMM",
  "Title": "Epigenomic R-based analysis with hidden Markov models",
  "Version": "1.19.0",
  "Date": "2025-09-16",
  "Authors@R": "c(person(\"Pedro\", \"Baldoni\", email = \"pedrobaldoni@gmail.com\", role = c(\"aut\",\"cre\")))",
  "biocViews": "ChIPSeq, ATACSeq, DNaseSeq, HiddenMarkovModel, Epigenetics",
  "Description": "epigraHMM provides a set of tools for the analysis of\nepigenomic data based on hidden Markov Models. It contains two\nseparate peak callers, one for consensus peaks from biological\nor technical replicates, and one for differential peaks from\nmulti-replicate multi-condition experiments. In differential\npeak calling, epigraHMM provides window-specific posterior\nprobabilities associated with every possible combinatorial\npattern of read enrichment across conditions.",
