{
  "Package": "txdbmaker",
  "Title": "Tools for making TxDb objects from genomic annotations",
  "Description": "A set of tools for making TxDb objects from genomic\nannotations from various sources (e.g. UCSC, Ensembl, and GFF\nfiles). These tools allow the user to download the genomic\nlocations of transcripts, exons, and CDS, for a given assembly,\nand to import them in a TxDb object. TxDb objects are\nimplemented in the GenomicFeatures package, together with\nflexible methods for extracting the desired features in\nconvenient formats.",
  "biocViews": "Infrastructure, DataImport, Annotation, GenomeAnnotation,\nGenomeAssembly, Genetics, Sequencing",
  "URL": "https://bioconductor.org/packages/txdbmaker",
  "BugReports": "https://github.com/Bioconductor/txdbmaker/issues",
  "Version": "1.7.3",
  "License": "Artistic-2.0",
